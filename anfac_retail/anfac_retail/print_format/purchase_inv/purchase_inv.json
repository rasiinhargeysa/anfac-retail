 "doc_type": "Purchase Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        color: #000;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .print-wrapper {\r\n        width: 100%;\r\n        padding: 8px 18px;\r\n    }\r\n\r\n    .brand-header {\r\n        text-align: center;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .supplier-info {\r\n        margin-bottom: 18px;\r\n        font-size: 12px;\r\n        color: #000;\r\n    }\r\n\r\n    .supplier-title {\r\n        font-weight: bold;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .supplier-name {\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n    }\r\n\r\n    .doc-title {\r\n        text-align: center;\r\n        color: #10194f;\r\n        font-size: 22px;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        letter-spacing: 4px;\r\n        margin: 8px 0 4px;\r\n    }\r\n\r\n    .title-orange-line {\r\n        width: 140px;\r\n        height: 3px;\r\n        background-color: #e36c12;\r\n        margin: 8px auto 6px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .grn-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n        font-size: 13px;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .grn-row b {\r\n        font-weight: bold;\r\n    }\r\n\r\n    .info-section {\r\n        border: 2px solid #10194f;\r\n        border-radius: 9px;\r\n        background-color: #f7f8fb;\r\n        padding: 14px 16px;\r\n        margin-bottom: 14px;\r\n        border-top: 4px solid #e36c12;\r\n        line-height: 0.6;\r\n    }\r\n\r\n    .details-grid {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        gap: 18px;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .details-grid:last-child {\r\n        margin-bottom: 0;\r\n    }\r\n\r\n    .details-cell {\r\n        width: 25%;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .details-cell-half {\r\n        width: 50%;\r\n        font-size: 12px;\r\n    }\r\n\r\n    .details-label {\r\n        color: #10194f;\r\n        font-weight: bold;\r\n        margin-bottom: 7px;\r\n        letter-spacing: 0.4px;\r\n    }\r\n\r\n    .details-value {\r\n        color: #000;\r\n        font-weight: normal;\r\n    }\r\n\r\n    .items-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: auto;\r\n        font-size: 10px;\r\n        margin-top: 10px;\r\n    }\r\n\r\n    .items-table th {\r\n        background-color: #10194f;\r\n        color: #fff;\r\n        border: 1px solid #fff;\r\n        padding: 8px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        line-height: 0.6;\r\n    }\r\n\r\n    .items-table th:first-child {\r\n        border-left: 1px solid #10194f;\r\n    }\r\n\r\n    .items-table th:last-child {\r\n        border-right: 1px solid #10194f;\r\n    }\r\n\r\n    .items-table td {\r\n        border: 1px solid #777;\r\n        padding: 0px;\r\n        vertical-align: top;\r\n        line-height: 0.9;\r\n    }\r\n\r\n    .items-table tbody tr:nth-child(even) {\r\n        background-color: #f7f8fb;\r\n    }\r\n\r\n    /* Service Type: only as wide as its content */\r\n    .items-table .col-service {\r\n        width: 1%;\r\n        white-space: nowrap;\r\n        padding: 0 8px;\r\n    }\r\n\r\n    /* Description under the Service Type (wraps, capped width) */\r\n    .items-table .item-desc {\r\n        white-space: normal;\r\n        max-width: 220px;\r\n        font-size: 9px;\r\n        font-weight: normal;\r\n        line-height: 1.2;\r\n        color: #444;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    /* Name: takes all the remaining space */\r\n    .items-table .col-name {\r\n        width: auto;\r\n        padding: 0 8px;\r\n    }\r\n\r\n    .text-center {\r\n        text-align: center;\r\n    }\r\n\r\n    .text-right {\r\n        text-align: right;\r\n    }\r\n\r\n    .product-name {\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        color: #000;\r\n    }\r\n\r\n    .total-box {\r\n        width: 330px;\r\n        margin-left: auto;\r\n        margin-top: 10px;\r\n        border: 1px solid #777;\r\n    }\r\n\r\n    .total-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        background-color: #10194f;\r\n        color: white !important;\r\n        padding: 8px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .words-row {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        gap: 10px;\r\n        border-top: 3px solid #e36c12;\r\n        padding: 8px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .words-row span:first-child {\r\n        font-weight: bold;\r\n        min-width: 95px;\r\n    }\r\n\r\n    .print-meta {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 18px;\r\n        padding-top: 6px;\r\n        border-top: 1px solid #ccc;\r\n        font-size: 10px;\r\n        color: #555;\r\n    }\r\n\r\n    .print-meta b {\r\n        color: #000;\r\n    }\r\n\r\n    .notes-section {\r\n        margin-top: 16px;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        color: #000;\r\n    }\r\n\r\n    .notes-section span {\r\n        font-weight: normal;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .signature-section {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        margin-top: 45px;\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .signature-box {\r\n        width: 30%;\r\n        text-align: center;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1px solid #000;\r\n        padding-top: 6px;\r\n    }\r\n\r\n    @media print {\r\n        .print-wrapper {\r\n            padding: 5px 15px;\r\n        }\r\n\r\n        .items-table th,\r\n        .items-table td {\r\n            padding: 6px;\r\n        }\r\n\r\n        .items-table .col-service,\r\n        .items-table .col-name {\r\n            padding: 6px 8px;\r\n        }\r\n\r\n        .total-row,\r\n        .total-row span {\r\n            color: #fff !important;\r\n            background-color: #10194f !important;\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n    }\r\n</style>\r\n\r\n<div class=\"print-wrapper\">\r\n\r\n    <!-- Letter Head / Brand -->\r\n    <div class=\"brand-header\">\r\n        {{ letter_head }}\r\n    </div>\r\n\r\n    <!-- Supplier Info -->\r\n    <div class=\"supplier-info\">\r\n        <div class=\"supplier-name\">Supplier: {{ doc.supplier or \"\" }}</div>\r\n    </div>\r\n\r\n    <!-- Title -->\r\n    <div class=\"doc-title\">Purchase Invoice</div>\r\n    <div class=\"title-orange-line\"></div>\r\n\r\n    <!-- PINV Number and Date -->\r\n    <div class=\"grn-row\">\r\n        <div>\r\n            <b>PINV.</b>\r\n            {{ doc.name or \"\" }}\r\n        </div>\r\n\r\n        <div>\r\n            <b>Dated:</b>\r\n            {{ doc.posting_date or \"\" }}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Brand Colored Info Section -->\r\n    <div class=\"info-section\">\r\n\r\n        <div class=\"details-grid\">\r\n            {% if doc.posting_date %}\r\n            <div class=\"details-cell\">\r\n                <div class=\"details-label\">Po Date</div>\r\n                <div class=\"details-value\">{{ doc.posting_date }}</div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if doc.bill_no %}\r\n            <div class=\"details-cell\">\r\n                <div class=\"details-label\">Suppl. Invoice</div>\r\n                <div class=\"details-value\">{{ doc.bill_no }}</div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if doc.posting_date %}\r\n            <div class=\"details-cell\">\r\n                <div class=\"details-label\">Invoice. Date</div>\r\n                <div class=\"details-value\">{{ doc.posting_date }}</div>\r\n            </div>\r\n            {% endif %}\r\n        </div>\r\n\r\n        <div class=\"details-grid\">\r\n            <div class=\"details-cell-half\">\r\n                <div class=\"details-label\">User</div>\r\n                <div class=\"details-value\">\r\n                    {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") or \"\" }}\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"details-cell-half\">\r\n                <div class=\"details-label\">Contact number</div>\r\n                <div class=\"details-value\">\r\n                    {{ frappe.db.get_value(\"User\", frappe.session.user, \"mobile_no\") or \"-\" }}\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- Work out which optional columns have at least one value -->\r\n    {% set ns = namespace(show_name=false, show_pnr=false) %}\r\n    {% for item in doc.items %}\r\n        {% if item.custom_title or item.custom_name %}{% set ns.show_name = true %}{% endif %}\r\n        {% if item.custom_number %}{% set ns.show_pnr = true %}{% endif %}\r\n    {% endfor %}\r\n\r\n    <!-- Items Table -->\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width: 45px;\">SN.</th>\r\n                <th class=\"col-service\" style=\"text-align: left;\">Service Type</th>\r\n                {% if ns.show_name %}\r\n                <th class=\"col-name\" style=\"text-align: left;\">Name</th>\r\n                {% endif %}\r\n                {% if ns.show_pnr %}\r\n                <th style=\"width: 80px;\">Refference</th>\r\n                {% endif %}\r\n                <th style=\"width: 60px;\">Qty</th>\r\n                <th style=\"width: 90px;\">PRICE</th>\r\n                <th style=\"width: 105px;\">AMOUNT</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td class=\"text-center\">{{ loop.index }}</td>\r\n\r\n                {% set desc = (item.description or \"\")|striptags|trim %}\r\n                <td class=\"col-service\">\r\n                    <span class=\"product-name\">{{ item.item_code or \"\" }}</span>\r\n                    {% if desc and desc|lower != (item.item_code or \"\")|trim|lower %}\r\n                    <div class=\"item-desc\">{{ desc }}</div>\r\n                    {% endif %}\r\n                </td>\r\n\r\n                {% if ns.show_name %}\r\n                <td class=\"col-name\">\r\n                    <span class=\"product-name\">\r\n                        {{ item.custom_title or \"\" }} {{ item.custom_name or \"\" }}\r\n                    </span>\r\n                </td>\r\n                {% endif %}\r\n\r\n                {% if ns.show_pnr %}\r\n                <td class=\"text-center\">\r\n                    <b>{{ item.custom_number or \"\" }}</b>\r\n                </td>\r\n                {% endif %}\r\n\r\n                <td class=\"text-center\">\r\n                    <b>{{ item.qty }}</b>\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    ${{ item.rate or 0 }}\r\n                </td>\r\n\r\n                <td class=\"text-right\">\r\n                    <b>${{ item.amount or 0 }}</b>\r\n                </td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Total -->\r\n    <div class=\"total-box\">\r\n        <div class=\"total-row\">\r\n            <span>Total</span>\r\n            <span>${{ doc.grand_total or 0 }}</span>\r\n        </div>\r\n\r\n        <div class=\"words-row\">\r\n            <span>Amount in Words</span>\r\n            <span style=\"text-align: right; font-weight: bold;\">\r\n                {{ doc.in_words or \"\" }}\r\n            </span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Created by / Print date and time -->\r\n    <div class=\"print-meta\">\r\n        <div>\r\n            Created by:\r\n            <b>{{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner or \"\" }}</b>\r\n        </div>\r\n        <div>\r\n            Print Date: <b>{{ frappe.utils.format_datetime(frappe.utils.now(), \"dd-MM-yyyy\") }}</b>\r\n            &nbsp;&nbsp;\r\n            Print Time: <b>{{ frappe.utils.format_datetime(frappe.utils.now(), \"HH:mm\") }}</b>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Notes -->\r\n    <!--<div class=\"notes-section\">-->\r\n    <!--    <div style=\"margin-bottom: 6px;\">-->\r\n    <!--        Incoterm:-->\r\n    <!--        <span>{{ doc.incoterm or \"DELIVERED AT PLACE UNLOADED\" }}</span>-->\r\n    <!--    </div>-->\r\n\r\n    <!--    <div>-->\r\n    <!--        Payment Schedule:-->\r\n    <!--    </div>-->\r\n    <!--</div>-->\r\n\r\n    <!-- Signatures -->\r\n    <!--<div class=\"signature-section\">-->\r\n    <!--    <div class=\"signature-box\">-->\r\n    <!--        <div class=\"signature-line\">Prepared By Accountant</div>-->\r\n    <!--    </div>-->\r\n\r\n    <!--    <div class=\"signature-box\">-->\r\n    <!--        <div class=\"signature-line\">Checked By Finance</div>-->\r\n    <!--    </div>-->\r\n\r\n    <!--    <div class=\"signature-box\">-->\r\n    <!--        <div class=\"signature-line\">Approved By Director</div>-->\r\n    <!--    </div>-->\r\n    <!--</div>-->\r\n\r\n</div>",
